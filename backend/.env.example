# Copy this file to .env and replace every placeholder before starting.
# Never commit .env or share these values.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@localhost:5432/hacktech_li
# Use a long, random value in any shared or production environment.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
# For local use, the backend serves the frontend on the same origin.
CORS_ORIGIN=http://localhost:4000
# Required only when creating staff/admin users through the invite flow.
ADMIN_INVITE_CODE=replace_with_admin_invite_code
# Required when using the n8n integration.
N8N_WEBHOOK_TOKEN=replace_with_n8n_webhook_token
N8N_WEBHOOK_URL=http://localhost:5678/webhook/reservation-created
# Uploaded files stay outside the public frontend and are created at runtime.
UPLOAD_DIR=./storage/private
MAX_FILE_SIZE_BYTES=10485760
MAX_FILES_PER_REQUEST=5
# Ollama is optional; install it and download the model if chatbot AI is needed.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
